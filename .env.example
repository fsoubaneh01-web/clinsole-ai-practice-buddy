# Public Supabase settings (same project may be retained for an isolated preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use VITE_ for this key.
SUPABASE_SERVICE_ROLE_KEY=

# Existing Lovable deployments remain the default. To leave Lovable AI:
CLINSOLE_AI_PROVIDER=gateway
AI_GATEWAY_MODEL=google/gemini-2.5-flash
AI_GATEWAY_API_KEY=
# Vercel deployments may authenticate using their runtime OIDC token instead.
# LOVABLE_API_KEY= (only needed with CLINSOLE_AI_PROVIDER=lovable)

# Portable Node hosting is the default build; Nitro also supports other presets.
NITRO_PRESET=node-server
# CLINSOLE_BUILD_TARGET=lovable (optional compatibility build)

# Voice dictation: server only. Use an isolated bucket and least-privilege IAM.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_TRANSCRIBE_BUCKET=
DICTATION_MONTHLY_MINUTE_LIMIT=120
DICTATION_GLOBAL_MONTHLY_SPEND_CAP=15
VITE_DICTATION_MONTHLY_MINUTE_LIMIT=120
